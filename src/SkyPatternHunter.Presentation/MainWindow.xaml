<Window x:Class="SkyPatternHunter.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sky Pattern Hunter"
        Width="1120"
        Height="720"
        Background="#0F172A"
        Foreground="#E2E8F0">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#172033" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Sky Pattern Hunter" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="A simple desktop shell for overhead aircraft tracking"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="16" Padding="20">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" />
                <UniformGrid Columns="3" Margin="0,16,0,0">
                    <Border Background="#0B1220" CornerRadius="12" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Aircraft tracked" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding EventCount}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0B1220" CornerRadius="12" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Latest aircraft" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding LatestAircraftHex}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0B1220" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Last observed" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding LatestObservedAtText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="4" Background="{StaticResource CardBackground}" BorderThickness="0" Padding="16">
            <TabItem Header="Active">
                <ListView x:Name="ActiveEventsList" ItemsSource="{Binding ActiveEvents}" Margin="0,12,0,0" VirtualizingPanel.IsVirtualizing="False">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Observed" DisplayMemberBinding="{Binding ObservedAtText}" Width="Auto" />
                            <GridViewColumn Header="Flight" DisplayMemberBinding="{Binding Flight}" Width="Auto" />
                            <GridViewColumn Header="Aircraft" DisplayMemberBinding="{Binding AircraftDescription}" Width="Auto" />
                            <GridViewColumn Header="Look Toward" DisplayMemberBinding="{Binding LookDirectionText}" Width="Auto" />
                            <GridViewColumn Header="Direction" DisplayMemberBinding="{Binding DirectionText}" Width="Auto" />
                            <GridViewColumn Header="Altitude" DisplayMemberBinding="{Binding AltitudeText}" Width="Auto" />
                            <GridViewColumn Header="Vertical" DisplayMemberBinding="{Binding AltitudeTrendText}" Width="Auto" />
                            <GridViewColumn Header="Speed" DisplayMemberBinding="{Binding SpeedText}" Width="Auto" />
                            <GridViewColumn Header="MPH" DisplayMemberBinding="{Binding MphText}" Width="Auto" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Today">
                <ListView x:Name="TodayEventsList" ItemsSource="{Binding TodayEvents}" Margin="0,12,0,0" VirtualizingPanel.IsVirtualizing="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="Stale">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Observed" DisplayMemberBinding="{Binding ObservedAtText}" Width="Auto" />
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="Auto" />
                            <GridViewColumn Header="Flight" DisplayMemberBinding="{Binding Flight}" Width="Auto" />
                            <GridViewColumn Header="Aircraft" DisplayMemberBinding="{Binding AircraftDescription}" Width="Auto" />
                            <GridViewColumn Header="Look Toward" DisplayMemberBinding="{Binding LookDirectionText}" Width="Auto" />
                            <GridViewColumn Header="Direction" DisplayMemberBinding="{Binding DirectionText}" Width="Auto" />
                            <GridViewColumn Header="Altitude" DisplayMemberBinding="{Binding AltitudeText}" Width="Auto" />
                            <GridViewColumn Header="Vertical" DisplayMemberBinding="{Binding AltitudeTrendText}" Width="Auto" />
                            <GridViewColumn Header="Speed" DisplayMemberBinding="{Binding SpeedText}" Width="Auto" />
                            <GridViewColumn Header="MPH" DisplayMemberBinding="{Binding MphText}" Width="Auto" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Settings">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Readsb JSON source" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding ReadsbJsonUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,14" Padding="10" />
                    <TextBlock Text="Readsb host" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding ReadsbHost, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,14" Padding="10" />
                    <TextBlock Text="Readsb port" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="{Binding ReadsbPort, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,14" Padding="10" />
                    <TextBlock Text="Notification prefix" Foreground="{StaticResource MutedBrush}" />
                    <TextBox Text="Overhead alert" Margin="0,6,0,14" Padding="10" />
                    <CheckBox Content="Enable Discord notifications" IsChecked="True" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Log">
                <TextBox Text="{Binding RuntimeStatusMessage, Mode=OneWay}" IsReadOnly="True" Margin="0,12,0,0" Padding="12" Background="#0B1220" Foreground="{StaticResource AccentBrush}" BorderThickness="0" TextWrapping="Wrap" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
